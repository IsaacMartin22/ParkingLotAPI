# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.war
*.nar
*.ear
*.tar.gz
*.rar

# Keep the checked-in New Relic agent files available to Docker builds and CI.
!newrelic/*.jar
!newrelic/*.zip
!newrelic/*.yml

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output (matches target/ in any module)
target/
*.envvars
*.key