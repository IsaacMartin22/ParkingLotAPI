<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 version="3.1">
    <entity class="apiservice.dbentity.ChatInteraction">
        <attributes>
            <basic name="embedding">
                <!-- H2 stores vector text only; pgvector operations require PostgreSQL. -->
                <column name="embedding" nullable="false" column-definition="varchar(65535)"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
